      "parameters": {
        "jsCode": "const response = $input.first().json;\n\n// Navigate the Next.js SSR structure\nconst queries = response?.pageProps?.dehydratedState?.queries ?? [];\n\n// Find the estatesSearch query (position may vary, so search by key)\nconst estatesQuery = queries.find(q => q?.queryKey?.[0] === 'estatesSearch');\nconst results = estatesQuery?.state?.data?.results ?? [];\n\nif (results.length === 0) {\n  return [{ json: { text: '⚠️ No results found or structure changed.' } }];\n}\n\nconst lines = results.map(p => {\n  const price = p.priceCzk\n    ? `${p.priceCzk.toLocaleString('cs-CZ')} Kč`\n    : 'cena na vyžádání';\n\n  const city    = p.locality?.city ?? '';\n  const district = p.locality?.district ?? '';\n  const location = [city, district].filter(Boolean).join(', ');\n\n  const type = p.categorySubCb?.name ?? p.categoryMainCb?.name ?? '';\n\n  const url = `https://www.sreality.cz/detail/${p.id}`;\n\n  return `• *${p.name}*\\n  🏷 ${type} | 📍 ${location}\\n  💰 ${price}\\n  🔗 ${url}`;\n});\n\nconst text = `🏠 *Sreality — ${results.length} listings*\\n\\n` + lines.join('\\n\\n');\n\nconst truncated = text.length > 4000\n  ? text.slice(0, 4000) + '\\n\\n_(truncated)_'\n  : text;\n\nreturn [{ json: { text: truncated } }];"
      },
