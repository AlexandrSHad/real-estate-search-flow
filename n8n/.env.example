# Copy this file to .env and fill in the values.
# Never commit .env to git.

# -------------------------
# Postgres — admin
# -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# -------------------------
# Postgres — app users
# Created by postgres/init.sh on first container boot.
# -------------------------
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_me

REALESTATE_DB=realestate
REALESTATE_DB_USER=realestate_app
REALESTATE_DB_PASSWORD=change_me

# -------------------------
# n8n
# -------------------------

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_ENCRYPTION_KEY=change_me_generate_with_node_command_above

N8N_USER=admin
N8N_PASSWORD=change_me
